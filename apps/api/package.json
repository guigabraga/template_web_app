{
  "name": "@template-web-app/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @template-web-app/db",
    "dev": "tsx watch --clear-screen=false --include \"src/**/*.ts\" --include tsconfig.json --include package.json src/Server.ts",
    "prebuild": "npm run build --workspace @template-web-app/db",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/Server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@template-web-app/db": "*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
