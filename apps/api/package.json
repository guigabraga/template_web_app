{
  "name": "@template-web-app/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"src/**/*.ts\" --include \"../../packages/db/dist/**/*.js\" --include \"../../packages/shared-types/dist/**/*.js\" --include tsconfig.json --include package.json src/Server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/Server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.8.48",
    "@template-web-app/db": "*",
    "@template-web-app/shared-types": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
