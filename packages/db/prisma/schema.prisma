// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String?   @unique(map: "users_username_key") @db.VarChar(80)
  email        String?   @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String?   @map("display_name") @db.VarChar(160)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions        UserPermission[] @relation("UserPermissionOwner")
  permissionsGranted UserPermission[] @relation("UserPermissionGrantor")
  logs               ApplicationLog[]

  @@index([isActive], map: "users_is_active_idx")
  @@map("users")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "permissions_code_key") @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users UserPermission[]

  @@index([isActive], map: "permissions_is_active_idx")
  @@map("permissions")
}

model UserPermission {
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  grantedById  String?   @map("granted_by_id") @db.Uuid
  isAllowed    Boolean   @default(true) @map("is_allowed")
  scope        Json?
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation("UserPermissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId], map: "user_permissions_permission_id_idx")
  @@index([grantedById], map: "user_permissions_granted_by_id_idx")
  @@index([expiresAt], map: "user_permissions_expires_at_idx")
  @@map("user_permissions")
}

model ApplicationLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  event         String   @db.VarChar(160)
  level         String   @default("INFO") @db.VarChar(20)
  message       String?  @db.Text
  source        String?  @db.VarChar(120)
  entityType    String?  @map("entity_type") @db.VarChar(120)
  entityId      String?  @map("entity_id") @db.VarChar(160)
  requestId     String?  @map("request_id") @db.VarChar(100)
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  success       Boolean?
  durationMs    Int?     @map("duration_ms")
  context       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "application_logs_user_id_created_at_idx")
  @@index([event, createdAt], map: "application_logs_event_created_at_idx")
  @@index([correlationId], map: "application_logs_correlation_id_idx")
  @@index([createdAt], map: "application_logs_created_at_idx")
  @@map("application_logs")
}
