{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_HOST",
    "API_PORT",
    "CHOKIDAR_INTERVAL",
    "CHOKIDAR_USEPOLLING",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "JWT_AUDIENCE",
    "JWT_EXPIRES_IN_SECONDS",
    "JWT_ISSUER",
    "JWT_SECRET",
    "NODE_ENV",
    "VITE_API_URL",
    "VITE_HOST",
    "VITE_PORT",
    "VITE_USE_POLLING",
    "VITE_WATCH_INTERVAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:create": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
