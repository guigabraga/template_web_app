{
  "name": "template_web_app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace @template-web-app/web",
    "build:web": "npm run build --workspace @template-web-app/web",
    "preview:web": "npm run preview --workspace @template-web-app/web",
    "dev:api": "npm run dev --workspace @template-web-app/api",
    "build:api": "npm run build --workspace @template-web-app/api",
    "start:api": "npm run start --workspace @template-web-app/api",
    "typecheck:api": "npm run typecheck --workspace @template-web-app/api",
    "db:generate": "npm run generate --workspace @template-web-app/db",
    "db:migrate": "npm run db:migrate --workspace @template-web-app/db --",
    "db:migrate:create": "npm run db:migrate:create --workspace @template-web-app/db --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @template-web-app/db",
    "db:studio": "npm run db:studio --workspace @template-web-app/db",
    "compose:dev:config": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml config",
    "compose:dev:up": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml up --build --force-recreate --detach",
    "compose:dev:down": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml down --remove-orphans",
    "compose:dev:reset": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml down --volumes --remove-orphans",
    "compose:dev:logs": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml logs --follow",
    "compose:dev:ps": "docker compose --env-file compose/dev/.env -f compose/dev/docker-compose.yml ps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript-eslint": "^8.65.0"
  }
}
