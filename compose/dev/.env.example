COMPOSE_PROJECT_NAME=template-web-app-dev

API_EXTERNAL_PORT=3001
WEB_EXTERNAL_PORT=3002
POSTGRES_EXTERNAL_PORT=5432
CORS_ORIGIN=http://localhost:3002

POSTGRES_USER=template_web_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=template_web_app

JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_ISSUER=template-web-app-api
JWT_AUDIENCE=template-web-app-web
JWT_EXPIRES_IN_SECONDS=900

# Caminho opcional de uma CA corporativa dentro do container.
NODE_EXTRA_CA_CERTS=
